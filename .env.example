# Copy to .env and fill in, or export these in your shell.
# NEVER commit real values - on GitHub these belong in repository Secrets.

# From @BotFather after /newbot
TELEGRAM_BOT_TOKEN=

# One or more channels, separated by commas. The SAME articles go to every
# one of them. Add or remove channels here at any time - no code change.
#   Public channel:  @yourchannelname
#   Private channel: the numeric id, e.g. -1001234567890
# The bot must be an administrator with "Post Messages" in EVERY channel.
TELEGRAM_CHAT_IDS=@Market_PulseNews

# Optional
# DRY_RUN=1              # preview; sends nothing, writes no state
# SEED_ON_FIRST_RUN=true # a newly added channel seeds instead of backfilling
# MAX_PER_RUN=40         # flood guard, applied per channel
# STATE_PATH=state/seen.json
