# Copy to .env and fill in, or export these in your shell.
# NEVER commit real values - on GitHub these belong in repository Secrets.

# From @BotFather after /newbot
TELEGRAM_BOT_TOKEN=

# Public channel: @yourchannelname
# Private channel: the numeric id, e.g. -1001234567890
TELEGRAM_CHAT_ID=

# Optional
# DRY_RUN=1              # print messages instead of sending
# SEED_ON_FIRST_RUN=true # first run records the backlog silently
# MAX_PER_RUN=40         # flood guard
# STATE_PATH=state/seen.json
